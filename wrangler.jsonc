/**
 * Worker configuration (PRD §9.5).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veek-portfolio",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contact@veek.me"],
    },
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2601",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veek-portfolio",
      "database_id": "42df817c-1694-4137-b584-0a9648475d49",
      "migrations_dir": "drizzle",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "veek_portfolio_events",
    },
  ],
  // Custom domains (PRD §9.5, M6 cutover 2026-10-28). www redirects to the apex in workers/app.ts.
  "routes": [
    { "pattern": "veek.me", "custom_domain": true },
    { "pattern": "www.veek.me", "custom_domain": true },
  ],
  "vars": {
    // Public Turnstile site key for the contact widget (action "contact").
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFisNj5DU2mpX_9j",
    // Frontend hostnames siteverify must report for this deployment. Never localhost here.
    "TURNSTILE_HOSTNAMES": "veek-portfolio.codewithveek.workers.dev,veek.me",
    "BUILD_ID": "dev",
  },
}
