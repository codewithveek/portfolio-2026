{
  "name": "veek-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm build && vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:fetch": "node scripts/fetch-writing.ts && node scripts/fetch-package-stats.ts",
    "images:build": "node scripts/build-images.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "og:build": "node scripts/build-og-images.ts",
    "screenshots": "node tools/screenshots/capture.ts"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "lenis": "1.3.27",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "6.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
