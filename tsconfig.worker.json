{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/+server-build.d.ts",
    "workers/**/*",
    "app/shared/lib/request-context.ts",
    "app/features/theme/theme-script.ts",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2023"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
