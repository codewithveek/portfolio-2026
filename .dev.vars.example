# Copy to .dev.vars for local development. Never commit real values.
# Local development and e2e use Turnstile's always-pass test keys (PRD §11, M4); they override
# the real site key in wrangler.jsonc. The test secret reports the hostname example.com.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=example.com
CONTACT_INBOX=you@example.com
IP_HASH_SALT=replace-with-a-long-random-string
